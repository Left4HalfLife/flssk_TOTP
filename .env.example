# Copy to .env and replace all placeholders before starting Compose.
SECRET_KEY=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
TOTP_ISSUER_NAME=Flask Accounts
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-long-initial-password
# Browser origin must match exactly. Change both values for HTTPS deployment.
PUBLIC_ORIGIN=http://localhost:8000
WEBAUTHN_RP_ID=localhost
